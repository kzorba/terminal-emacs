# Stage 1: Build Emacs (nox version)
FROM ubuntu:noble AS builder
LABEL org.opencontainers.image.authors="Kostas Zorbadelos <kzorba@nixly.net>"

# Install build dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    gcc-14 g++-14 libgccjit-14-dev \
    git \
    make libc6-dev \
    libgnutls28-dev \
    libjansson-dev \
    libtree-sitter-dev \
    libxml2-dev \
    zlib1g-dev \
    pkg-config \
    libncurses-dev \
    texinfo \
    wget \
    xz-utils

ENV EMACS_VERSION="31.1"

# Download and build Emacs
RUN cd /tmp && \
    wget https://ftp.gnu.org/gnu/emacs/emacs-${EMACS_VERSION}.tar.xz && \
    tar -xJf emacs-${EMACS_VERSION}.tar.xz && \
    cd emacs-${EMACS_VERSION} && \
    export CC=gcc-14 && \
    export CXX=g++-14 && \
    ./configure \
      --without-x --without-x-toolkit \
      --without-gconf --without-gsettings \
      --without-imagemagick \
      --without-sound --without-dbus \
      --without-gpm && \
    make -j"$(nproc)" && \
    make install DESTDIR=/emacs-install

# Stage 2: Create runtime image with all tools
FROM phusion/baseimage:noble-1.0.2
LABEL org.opencontainers.image.authors="Kostas Zorbadelos <kzorba@nixly.net>"

# Accept UID, GID, USERNAME, DOCKER_GID as build arguments (with defaults).
# These are parameters for the effective user id emacs runs as inside
# the container.
# The docker group should give access to the host's docker if available.
# During the build UID, GID and DOCKER_GID should correspond to the ones
# in the host.
ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=emacsuser
ARG DOCKER_GID=1000
ARG DOOM_REPO=https://github.com/doomemacs/core
ARG DOOM_COMMIT=01d68aaf6bd7db073365385cd82e1ad7e815295c

ENV USERNAME=${USERNAME}
ENV USER_UID=${USER_UID}
ENV USER_GID=${USER_GID}
ENV DOCKER_GID=${DOCKER_GID}
ENV DOOM_REPO=${DOOM_REPO}
ENV DOOM_COMMIT=${DOOM_COMMIT}

# Support a truecolor terminal. You can comment xterm-direct and
# uncomment the other 2 lines, could be more portable.
# ENV TERM="xterm-256color"
# ENV COLORTERM="truecolor"
ENV TERM="xterm-direct"

# This directory should map to the user's home directory in the host.
# We just put an initial value here, but we expect it will be set
# accordingly, when the container is run.
ENV WORKDIR="/h"

# Install runtime dependencies and tools
RUN apt-get update && \
    apt-get install -y ca-certificates curl && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb" \
         "[arch=$(dpkg --print-architecture)" \
         "signed-by=/etc/apt/keyrings/docker.asc]" \
         "https://download.docker.com/linux/ubuntu" \
         "noble stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y \
    direnv \
    docker-ce-cli \
    fd-find \
    git \
    git-lfs \
    libgnutls30 \
    libjansson4 \
    libncurses6 \
    libgccjit0 \
    libtree-sitter0 \
    ncurses-base \
    ncurses-term \
    pandoc \
    ripgrep \
    shfmt \
    zsh

# Copy Emacs from builder
COPY --from=builder /emacs-install/usr/local /usr/local

# Delete ubuntu user, create a ${USERNAME}
RUN deluser --remove-home ubuntu && \
    groupadd -g ${USER_GID} -f ${USERNAME} && \
    groupadd -g ${DOCKER_GID} -o docker && \
    useradd -d /h/${USERNAME} -m -s /bin/zsh -u ${USER_UID} -g ${USER_GID} -G docker ${USERNAME} && \
    passwd -d ${USERNAME}

# Install the tools and ssh key in ${USERNAME}
USER ${USERNAME}

# Copy dotfiles
COPY --chown=${USERNAME}:${USERNAME} dotfiles/doom/init.orgman.el /h/${USERNAME}/.config/doom/init.el
COPY --chown=${USERNAME}:${USERNAME} dotfiles/doom/config.orgman.el /h/${USERNAME}/.config/doom/config.el
COPY --chown=${USERNAME}:${USERNAME} dotfiles/doom/packages.orgman.el /h/${USERNAME}/.config/doom/packages.el
COPY --chown=${USERNAME}:${USERNAME} dotfiles/git/gitconfig /h/${USERNAME}/.gitconfig
COPY --chown=${USERNAME}:${USERNAME} dotfiles/zsh/zshrc /tmp/.zshrc
# Copy emacsuser public key
COPY --chown=${USERNAME}:${USERNAME} emacsuser.pub /tmp/emacsuser.pub

# Specific Doom emacs commit for reproducibility
RUN mkdir -p /h/${USERNAME}/.config/emacs \
 && git -C /h/${USERNAME}/.config/emacs init \
 && git -C /h/${USERNAME}/.config/emacs remote add origin "$DOOM_REPO" \
 && git -C /h/${USERNAME}/.config/emacs fetch --depth=1 origin "$DOOM_COMMIT" \
 && git -C /h/${USERNAME}/.config/emacs checkout --detach FETCH_HEAD \
 && test "$(git -C /h/${USERNAME}/.config/emacs rev-parse HEAD)" = "$DOOM_COMMIT"

# Tools under $USERNAME
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" && \
    # zsh / ssh key
    mv /tmp/.zshrc ~/.zshrc && \
    mkdir /h/${USERNAME}/.ssh && \
    chmod 700 /h/${USERNAME}/.ssh && \
    cat /tmp/emacsuser.pub >> /h/${USERNAME}/.ssh/authorized_keys

# doom install / sync / env
RUN /h/${USERNAME}/.config/emacs/bin/doom install --force

USER root

# Adjust the container to the host environment
# Enable ssh service
COPY scripts/adjust_env.sh /etc/my_init.d/90_adjust_env.sh
RUN chmod +x /etc/my_init.d/90_adjust_env.sh && \
    rm -f /etc/service/sshd/down && \
    /etc/my_init.d/00_regen_ssh_host_keys.sh

# Copy the service script
# emacs daemon
RUN mkdir /etc/service/emacs-daemon
COPY scripts/emacs-daemon.sh /etc/service/emacs-daemon/run
RUN chmod +x /etc/service/emacs-daemon/run 

# Clean up
RUN apt-get auto-remove -y && \
    apt-get clean  && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/lib/apt/lists/*

# Use baseimage-docker's init system.
CMD ["/sbin/my_init"]
